{
  "pack": {
    "width": {
      "$value": "{size.pack}",
      "$type": "dimension",
      "$description": "Width of the booster."
    },
    "radius": {
      "$value": "{radius.sm}",
      "$type": "dimension",
      "$description": "Corner radius of the booster."
    }
  },
  "tear": {
    "line": {
      "$value": 0.14,
      "$type": "number",
      "$description": "Height of the strip that gets torn off, as a fraction of the pack height."
    },
    "zone": {
      "$value": 0.26,
      "$type": "number",
      "$description": "Height of the grab area around the tear line, as a fraction of the pack height."
    },
    "overflow": {
      "$value": 0.14,
      "$type": "number",
      "$description": "How far the grab area extends past each side of the pack, as a fraction of its width."
    }
  },
  "cut": {
    "color": {
      "$value": "{color.highlight.core}",
      "$type": "color",
      "$description": "Core of the glowing cut line."
    },
    "glow": {
      "$value": "{color.glow.default}",
      "$type": "color",
      "$description": "Halo of the cut line, the flash and the sparks."
    },
    "size": {
      "$value": "{size.stroke}",
      "$type": "dimension"
    },
    "tip-size": {
      "$value": "{size.knob}",
      "$type": "dimension"
    },
    "shadow": {
      "$type": "shadow",
      "$value": [
        {
          "color": "{color.glow.default}",
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "6px",
          "spread": "1px"
        },
        {
          "color": "{color.glow.default}",
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "18px",
          "spread": "4px"
        }
      ]
    }
  },
  "hint": {
    "color": {
      "$value": "{color.highlight.line}",
      "$type": "color",
      "$description": "Dashed line on the sealed pack."
    },
    "size": {
      "$value": "{size.hairline}",
      "$type": "dimension"
    },
    "label-color": {
      "$value": "{color.content.secondary}",
      "$type": "color",
      "$description": "Instruction text under the pack."
    },
    "label-size": {
      "$value": "{font.size.label}",
      "$type": "dimension"
    },
    "label-weight": {
      "$value": "{font.weight.label}",
      "$type": "fontWeight"
    },
    "label-gap": {
      "$value": "{space.500}",
      "$type": "dimension"
    },
    "label-space": {
      "$value": "{space.1200}",
      "$type": "dimension",
      "$description": "Room kept under the pack for the instruction text."
    },
    "inset": {
      "$value": 0.04,
      "$type": "number",
      "$description": "Horizontal inset of the dashed line, as a fraction of the pack width."
    }
  },
  "shine": {
    "color": {
      "$value": "{color.highlight.strong}",
      "$type": "color"
    },
    "sheen": {
      "$value": "{color.highlight.soft}",
      "$type": "color"
    },
    "opacity": {
      "$value": 0.55,
      "$type": "number",
      "$description": "Strength of the foil reflection (0 turns it off visually)."
    }
  },
  "spark": {
    "size": {
      "$value": "{size.dot}",
      "$type": "dimension"
    },
    "color": {
      "$value": "{color.highlight.core}",
      "$type": "color"
    },
    "count": {
      "$value": 14,
      "$type": "number",
      "$description": "Number of sparks when the strip is torn off."
    },
    "shadow": {
      "$type": "shadow",
      "$value": {
        "color": "{color.glow.default}",
        "offsetX": "0px",
        "offsetY": "0px",
        "blur": "6px",
        "spread": "2px"
      }
    }
  },
  "card": {
    "width-ratio": {
      "$value": 0.86,
      "$type": "number",
      "$description": "Card width relative to the pack width."
    },
    "ratio": {
      "$value": 0.7159,
      "$type": "number",
      "$description": "Card aspect ratio (63 / 88 by default)."
    },
    "radius": {
      "$value": "{radius.md}",
      "$type": "dimension"
    },
    "shadow": {
      "$type": "shadow",
      "$value": {
        "color": "{color.shadow.soft}",
        "offsetX": "0px",
        "offsetY": "12px",
        "blur": "30px",
        "spread": "0px"
      }
    },
    "glow-rare": {
      "$value": "{color.rarity.rare}",
      "$type": "color"
    },
    "glow-epic": {
      "$value": "{color.rarity.epic}",
      "$type": "color"
    },
    "glow-legendary": {
      "$value": "{color.rarity.legendary}",
      "$type": "color"
    },
    "glow-default": {
      "$value": "{color.glow.default}",
      "$type": "color",
      "$description": "Glow of cards with a custom rarity."
    },
    "holo-1": {
      "$value": "{color.holo.pink}",
      "$type": "color"
    },
    "holo-2": {
      "$value": "{color.holo.lilac}",
      "$type": "color"
    },
    "holo-3": {
      "$value": "{color.holo.sky}",
      "$type": "color"
    },
    "holo-4": {
      "$value": "{color.holo.mint}",
      "$type": "color"
    },
    "holo-5": {
      "$value": "{color.holo.sun}",
      "$type": "color"
    },
    "holo-shine": {
      "$value": "{color.highlight.strong}",
      "$type": "color"
    },
    "glow-ring": {
      "$value": "2px",
      "$type": "dimension"
    },
    "glow-blur": {
      "$value": "32px",
      "$type": "dimension"
    },
    "glow-spread": {
      "$value": "6px",
      "$type": "dimension"
    },
    "drag-rotation": {
      "$value": 12,
      "$type": "number",
      "$description": "Rotation of a card dragged by its full width, in degrees."
    }
  },
  "stack": {
    "offset": {
      "$value": "{space.200}",
      "$type": "dimension",
      "$description": "Vertical offset of each card under the top one."
    },
    "scale-step": {
      "$value": 0.02,
      "$type": "number"
    },
    "depth": {
      "$value": 4,
      "$type": "number",
      "$description": "How many cards stay visible under the top one."
    }
  },
  "summary": {
    "card-ratio": {
      "$value": 0.48,
      "$type": "number",
      "$description": "Card width in the summary, relative to a card in the stack."
    },
    "gap": {
      "$value": "{space.300}",
      "$type": "dimension"
    },
    "columns": {
      "$value": 5,
      "$type": "number"
    },
    "enter-offset": {
      "$value": "18px",
      "$type": "dimension"
    }
  },
  "focus": {
