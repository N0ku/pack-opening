    "gap": {
      "$value": "{space.600}",
      "$type": "dimension"
    },
    "font-size": {
      "$value": "{font.size.label}",
      "$type": "dimension"
    },
    "font-weight": {
      "$value": "{font.weight.label}",
      "$type": "fontWeight"
    }
  },
